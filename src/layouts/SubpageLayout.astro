---
import '../styles/global.css';
import '../styles/subpage.css';

interface Props {
  title: string;
  backHref: string;
}

const { title, backHref } = Astro.props;
---
<!doctype html>
<html lang="hy">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title} — Սամվել Մհերյան</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@300;400;700&family=Open+Sans:wght@300;400;600&display=swap"
    media="print"
    onload="this.media='all'"
  >
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@300;400;700&family=Open+Sans:wght@300;400;600&display=swap">
  </noscript>
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    media="print"
    onload="this.media='all'"
  >
</head>
<body>
  <nav class="sub-nav">
    <div class="container">
      <a href={backHref} class="back-link">
        <i class="fa fa-arrow-left"></i> Վերադառնալ
      </a>
    </div>
  </nav>

  <main class="sub-main">
    <div class="container">
      <slot />
    </div>
  </main>

  <footer class="sub-footer">
    <div class="container">
      <a href="/">← Գլխավոր էջ</a>
    </div>
  </footer>
</body>
</html>
