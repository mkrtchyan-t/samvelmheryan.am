---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import Lightbox from '../components/Lightbox.astro';

// gallery folder has images: 2-18, 20-27, 29-55 (no 1, 19, 28)
const nums = [
  ...Array.from({ length: 17 }, (_, i) => i + 2),     // 2-18
  ...Array.from({ length: 8 }, (_, i) => i + 20),      // 20-27
  ...Array.from({ length: 26 }, (_, i) => i + 29),     // 29-54
  55,
];

const images = nums.map(n => ({
  src: `/images/gallery/${n}.webp`,
  alt: `Պատկերասրահ — ${n}`,
}));
---
<SubpageLayout title="Պատկերասրահ" backHref="/#gallery">
  <h1 class="page-header">Պատկերասրահ</h1>

  <div class="gallery-page-grid">
    {images.map(img => (
      <div
        class="gallery-page-item"
        data-lightbox-src={img.src}
        data-lightbox-alt={img.alt}
        role="button"
        tabindex="0"
        aria-label={`Բացել՝ ${img.alt}`}
      >
        <img src={img.src} alt={img.alt} loading="lazy">
      </div>
    ))}
  </div>

  <Lightbox />
</SubpageLayout>
