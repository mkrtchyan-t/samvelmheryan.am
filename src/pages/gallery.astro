---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import site from '../../content/site.json';

const images = site.gallery.map((g, i) => ({
  src: g.image,
  alt: `Պատկերասրահ — ${i + 1}`,
}));

const cols: typeof images[] = [[], [], []];
images.forEach((img, i) => cols[i % 3].push(img));
---
<SubpageLayout title="Պատկերասրահ" backHref="/#gallery" bgImage="/images/gallery-bg.webp">
  <h1 class="page-header" data-i18n="gallery.title">Պատկերասրահ</h1>

  <div class="gallery-masonry">
    {cols.map((col, ci) => (
      <div class="gallery-col">
        {col.map((img, ri) => (
          <div
            class="gallery-page-item"
            data-lightbox-src={img.src}
            data-lightbox-alt={img.alt}
            data-lightbox-index={ri * 3 + ci}
            role="button"
            tabindex="0"
            aria-label={`Բացել՝ ${img.alt}`}
          >
            <img src={img.src} alt={img.alt} loading="lazy">
          </div>
        ))}
      </div>
    ))}
  </div>

  <Lightbox />
</SubpageLayout>
