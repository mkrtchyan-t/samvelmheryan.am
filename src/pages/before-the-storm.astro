---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import Lightbox from '../components/Lightbox.astro';

const pages = [1, 2, 3, 4].map(n => ({
  src: `/images/before-the-storm-page-000${n}.jpg`,
  alt: `Փոթորկից առաջ — էջ ${n}`,
}));
---
<SubpageLayout title="Փոթորկից առաջ" backHref="/#books">
  <h1 class="page-header">ՓՈԹՈՐԿԻՑ ԱՌԱՋ <small>պատմավեպ</small></h1>

  <div class="detail-grid">
    <img src="/images/before-the-storm.png" alt="Փոթորկից առաջ" width="240" height="360" loading="eager">
    <div class="detail-text">
      <p class="detail-meta">«Ասողիկ» հրատարակչություն, 2023թ.</p>
      <p>
        Վեպը նկարագրում է 3-րդ դարի վերջին Մեծ Հայքի 29-ամյա անիշխանության
        շրջանը, երբ Անակ Պարթևի ձեռքով դավադրաբար սպանվում է Խոսրով արքան,
        իսկ Սասանորդի Արտաշիրը, Պարսկաստանում նվաճելով Արշակունիների հարստությունը
        դիմում է Հայաստան։
      </p>
      <p>
        Ստեղծված խառնաշփոթում հայոց նախարարներից շատերը, փախչելով երկրից,
        ապաստան են գտնում Հռոմում, իսկ մնացածը, հնազանդվելով Արտաշիրի
        իշխանությանը, մնում են նրա հպատակության ներքո։ Այս համայնապատկերում,
        Մանդակունիների տոհմից մի իշխանորդի, Կապադովկյան Կեսարիայից Հայք
        վերադառնալով, մահափորձ է կատարում պարսից կուսակալի դեմ...
      </p>
    </div>
  </div>

  <h3 class="section-label">Հատված գրքից</h3>
  <div class="image-grid">
    {pages.map(p => (
      <div
        class="image-grid-item"
        data-lightbox-src={p.src}
        data-lightbox-alt={p.alt}
        role="button" tabindex="0" aria-label={`Բացել՝ ${p.alt}`}
      >
        <img src={p.src} alt={p.alt} loading="lazy">
      </div>
    ))}
  </div>

  <Lightbox />
</SubpageLayout>
