---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import Lightbox from '../components/Lightbox.astro';

const pages = [1, 2, 3, 4, 5, 6, 7].map(n => ({
  src: `/images/ajb-ke-page-000${n}.webp`,
  alt: `Այբ-Քէ — էջ ${n}`,
}));
---
<SubpageLayout title="Այբ-Քէ" backHref="/#books" bgImage="/images/ajb-ke-bg.webp">
  <h1 class="page-header">ԱՅԲ-ՔԷ <small>աղոթական բանաստեղծությունների ժողովածու</small></h1>

  <div class="detail-grid">
    <img src="/images/ajb-ke.webp" alt="Այբ-Քէ" width="240" height="360" loading="eager">
    <div class="detail-text">
      <p class="detail-meta">«Ասողիկ» հրատարակչություն, 2014թ. · 2017թ. · 2018թ. · 2021թ.</p>
      <p>
        Ես եմ Ալֆան եւ Օմեղան (ԱՅԲ–ը եւ ՔԷ-ն) [սկիզբը եւ վերջը] ասում է Տէրը,
        նա որ էր եւ որ է եւ որ գալու է, Ամենակալը: (Յայտն. 1.8)
      </p>
      <p>
        Այս ժողովածուն արտահայտում է քրիստոնյայի հուզերն ու մտորումները՝ ուղղված
        Արարիչ Աստծուն որպես ապաշխարության և փառաբանության խոնարհ աղոթականչեր...
      </p>
    </div>
  </div>

  <h3 class="section-label">Հատված գրքից</h3>
  <div class="image-grid">
    {pages.map(p => (
      <div
        class="image-grid-item"
        data-lightbox-src={p.src}
        data-lightbox-alt={p.alt}
        role="button" tabindex="0" aria-label={`Բացել՝ ${p.alt}`}
      >
        <img src={p.src} alt={p.alt} loading="lazy">
      </div>
    ))}
  </div>

  <Lightbox />
</SubpageLayout>
