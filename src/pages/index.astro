---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Carousel from '../components/Carousel.astro';
import Lightbox from '../components/Lightbox.astro';
import site from '../../content/site.json';

const { banners, books, films, gallery, contact, bio } = site;

const carouselSlides = banners.map((b, i) => ({ src: b.image, alt: `Նկար ${i + 1}`, href: b.href || undefined }));
const galleryPreview = gallery.slice(0, 6);
---

<Layout title="Սամվել Մհերյան">
  <Nav />

  <!-- ===== Autobiography ===== -->
  <section id="autobiography-section" class="hero-section">
    <div class="container">
      <div class="autobiography-grid fade-in">
        <img
          src={bio.photo || '/images/author-bg.webp'}
          alt="Սամվել Մհերյան"
          width="320"
          height="480"
          loading="eager"
          fetchpriority="high"
        >
        <div class="autobiography-text">
          {bio.paragraphs.map(p => <p>{p.hy}</p>)}
        </div>
      </div>

      <Carousel slides={carouselSlides} />
    </div>
  </section>

  <!-- ===== Books ===== -->
  <section id="books" class="hero-section" style="background-image:url('/images/books-bg.webp')">
    <div class="container">
      <h2 class="section-title fade-in">Գրքեր</h2>
      <div class="title-line fade-in"></div>
      <div class="books-scroll">
        {books.map(book => (
          <div class="book-card fade-in">
            {book.page
              ? <a href={`/${book.slug}`} class="book-card-inner">
                  <img src={book.image} alt={book.title.hy} width="180" height="240" loading="lazy">
                  <div class="book-card-overlay">{book.title.hy}</div>
                </a>
              : <div class="book-card-inner">
                  <img src={book.image} alt={book.title.hy} width="180" height="240" loading="lazy">
                  <div class="book-card-overlay">{book.title.hy}</div>
                </div>
            }
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Films ===== -->
  <section id="film" class="hero-section" style="background-image:url('/images/khnous2.webp')">
    <div class="container">
      <h2 class="section-title fade-in">Ֆիլմագրություն</h2>
      <div class="title-line fade-in"></div>
      <div class="films-grid">
        {films.map(film => (
          <a href={film.page ? `/${film.slug}` : undefined} class="film-card fade-in">
            <img src={film.image} alt={film.title.hy} loading="lazy">
            <div class="film-card-overlay">{film.title.hy}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Gallery ===== -->
  <section id="gallery" class="hero-section" style="background-image:url('/images/gallery-bg.webp')">
    <div class="container">
      <h2 class="section-title fade-in">Պատկերասրահ</h2>
      <div class="title-line fade-in"></div>
      <div class="gallery-grid">
        {galleryPreview.map((g, i) => (
          <div
            class="gallery-item fade-in"
            data-lightbox-src={g.image}
            data-lightbox-alt={`Նկար ${i + 1}`}
            role="button"
            tabindex="0"
            aria-label={`Բացել նկար ${i + 1}`}
          >
            <img
              src={g.image}
              alt={`Պատկերասրահ ${i + 1}`}
              loading="lazy"
            >
          </div>
        ))}
      </div>
      <div style="text-align:center">
        <a href="/gallery" class="see-more-btn">Տեսնել ավելին</a>
      </div>
    </div>
  </section>

  <!-- ===== Contact ===== -->
  <footer id="contact">
    <div class="contact-inner">
      <h2 class="section-title">ԿԱՊ</h2>
      <div class="title-line"></div>
      <p class="contact-sub">Հարցերի կամ համագործակցության համար՝</p>

      <div class="contact-cards">
        <a href={contact.facebook.url} class="contact-card contact-card--fb" rel="noopener" target="_blank">
          <div class="contact-card-icon contact-card-icon--fb">
            <i class="fa-brands fa-facebook-f"></i>
          </div>
          <span class="contact-card-label">Facebook</span>
          <span class="contact-card-handle">{contact.facebook.name.hy}</span>
          <span class="contact-fb-btn">
            <i class="fa-brands fa-facebook-f"></i>
            <span>Հետևել</span>
          </span>
        </a>

        <a href={`mailto:${contact.email.address}`} class="contact-card contact-card--email">
          <div class="contact-card-icon">
            <i class="fa-regular fa-envelope"></i>
          </div>
          <span class="contact-card-label">Էլ. փոստ</span>
          <span class="contact-card-handle">{contact.email.address}</span>
        </a>

        <a href={contact.linkedin.url} class="contact-card contact-card--linkedin" rel="noopener" target="_blank">
          <div class="contact-card-icon contact-card-icon--li">
            <i class="fa-brands fa-linkedin-in"></i>
          </div>
          <span class="contact-card-label">LinkedIn</span>
          <span class="contact-card-handle">{contact.linkedin.name.hy}</span>
        </a>
      </div>

      <p class="contact-copy">© Սամվել Մհերյան. Բոլոր իրավունքները պաշտպանված են.</p>
    </div>
    <a href="#" class="back-to-top" aria-label="Вeреv"><i class="fa-solid fa-circle-chevron-up"></i></a>
  </footer>

  <Lightbox />
</Layout>

<script>
  // Fade-in on scroll using IntersectionObserver (replaces WOW.js)
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('visible'); } }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>
