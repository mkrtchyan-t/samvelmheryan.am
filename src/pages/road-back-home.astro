---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import Lightbox from '../components/Lightbox.astro';

const galleryImgs = Array.from({ length: 28 }, (_, i) => ({
  src: `/images/road-back-home/${i + 1}.webp`,
  alt: `Տունդարձի ճամփան — նկար ${i + 1}`,
}));
---
<SubpageLayout title="Տունդարձի ճամփան" backHref="/#film" bgImage="/images/khnous2.webp">
  <h1 class="page-header">Տունդարձի ճամփան <small>սիրողական ֆիլմ</small></h1>

  <div class="detail-grid">
    <img src="/images/road-back-home-dvd.webp" alt="Տունդարձի ճամփան" width="240" height="300" loading="eager">
    <div class="detail-text">
      <div>
        <iframe
          src="https://www.youtube.com/embed/MG9Wab6F_g4"
          title="Տունդարձի ճամփան"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
          style="width:100%;aspect-ratio:16/9;border-radius:4px;"
        ></iframe>
      </div>
    </div>
  </div>

  <h3 class="section-label">Միջոցառումներ</h3>
  <div class="gallery-page-grid">
    {galleryImgs.map(img => (
      <div
        class="gallery-page-item"
        data-lightbox-src={img.src}
        data-lightbox-alt={img.alt}
        role="button" tabindex="0" aria-label={`Բացել՝ ${img.alt}`}
      >
        <img src={img.src} alt={img.alt} loading="lazy">
      </div>
    ))}
  </div>

  <Lightbox />
</SubpageLayout>
