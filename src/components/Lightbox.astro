---
---
<dialog id="lightbox" class="lb-dialog" aria-label="Նկար">
  <div class="lb-inner">
    <button class="lb-close" aria-label="Փակել">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
        <line x1="4" y1="4" x2="18" y2="18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <line x1="18" y1="4" x2="4" y2="18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
    <a id="lb-download" class="lb-download" aria-label="Բեռնել" download>
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
        <line x1="11" y1="3" x2="11" y2="15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <polyline points="6,11 11,16 16,11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <line x1="4" y1="19" x2="18" y2="19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </a>
    <button class="lb-prev" aria-label="Նախորդ">&#8249;</button>
    <div class="lb-img-wrap">
      <img id="lb-img" src="" alt="" loading="lazy">
    </div>
    <button class="lb-next" aria-label="Հաջորդ">&#8250;</button>
    <div class="lb-counter" id="lb-counter"></div>
  </div>
</dialog>

<style>
.lb-dialog {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  max-width: 100vw;
  max-height: 100vh;
  background: rgba(0,0,0,0.93);
  border: none;
  padding: 0;
  margin: 0;
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  overflow: hidden;
}
.lb-dialog[open] { display: flex; }
.lb-dialog::backdrop {
  background: rgba(0,0,0,0.93);
}

.lb-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  gap: 0;
}

.lb-img-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: calc(100vw - 120px);
  max-height: 92vh;
}

#lb-img {
  max-width: 100%;
  max-height: 88vh;
  object-fit: contain;
  display: block;
  border-radius: 2px;
  user-select: none;
}

.lb-close {
  position: fixed;
  top: 1.1rem;
  right: 1.25rem;
  background: none;
  border: none;
  color: rgba(255,255,255,0.7);
  cursor: pointer;
  z-index: 2;
  transition: color 0.15s;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lb-close:hover { color: #fff; }

.lb-download {
  position: fixed;
  top: 1rem;
  right: 3.75rem;
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  z-index: 2;
  transition: color 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lb-download:hover { color: #fff; }

.lb-prev,
.lb-next {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255,255,255,0.08);
  border: none;
  color: rgba(255,255,255,0.8);
  font-size: 3rem;
  line-height: 1;
  width: 56px;
  height: 80px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  z-index: 2;
  transition: background 0.15s, color 0.15s;
  user-select: none;
}
.lb-prev { left: 0.5rem; }
.lb-next { right: 0.5rem; }
.lb-prev:hover, .lb-next:hover {
  background: rgba(255,255,255,0.18);
  color: #fff;
}

/* Hide nav when only one image */
.lb-dialog.single .lb-prev,
.lb-dialog.single .lb-next { display: none; }

.lb-counter {
  position: fixed;
  bottom: 1rem;
  left: 50%;
  transform: translateX(-50%);
  color: rgba(255,255,255,0.45);
  font-size: 0.8rem;
  letter-spacing: 0.06em;
}

@media (max-width: 600px) {
  .lb-img-wrap { max-width: calc(100vw - 80px); }
  .lb-prev { left: 0.25rem; width: 36px; font-size: 2rem; }
  .lb-next { right: 0.25rem; width: 36px; font-size: 2rem; }
}
</style>

<script>
const dialog   = document.getElementById('lightbox') as HTMLDialogElement;
const imgEl    = document.getElementById('lb-img') as HTMLImageElement;
const counter  = document.getElementById('lb-counter') as HTMLElement;
const dlLink   = document.getElementById('lb-download') as HTMLAnchorElement;

let items: { src: string; alt: string }[] = [];
let idx = 0;

function show(i: number) {
  idx = (i + items.length) % items.length;
  imgEl.src = '';
  imgEl.src = items[idx].src;
  imgEl.alt = items[idx].alt;
  counter.textContent = items.length > 1 ? `${idx + 1} / ${items.length}` : '';
  dialog.classList.toggle('single', items.length === 1);
  dlLink.href = items[idx].src;
  dlLink.download = items[idx].src.split('/').pop() ?? 'image';
}

function open(triggers: NodeListOf<Element> | Element[], clickedSrc: string) {
  items = Array.from(triggers).map(el => ({
    src: (el as HTMLElement).dataset.lightboxSrc!,
    alt: (el as HTMLElement).dataset.lightboxAlt ?? '',
  }));
  const start = items.findIndex(it => it.src === clickedSrc);
  show(start >= 0 ? start : 0);
  dialog.showModal();
  document.body.style.overflow = 'hidden';
}

function close() {
  dialog.close();
  imgEl.src = '';
  document.body.style.overflow = '';
}

dialog.querySelector('.lb-close')!.addEventListener('click', close);
dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
dialog.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));

// Click outside image area closes
dialog.addEventListener('click', e => { if (e.target === dialog) close(); });

dialog.addEventListener('close', () => { document.body.style.overflow = ''; });

// Keyboard navigation
window.addEventListener('keydown', e => {
  if (!dialog.open) return;
  if (e.key === 'ArrowLeft')  { e.preventDefault(); show(idx - 1); }
  if (e.key === 'ArrowRight') { e.preventDefault(); show(idx + 1); }
});

// Touch swipe support
let touchStartX = 0;
dialog.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
dialog.addEventListener('touchend', e => {
  const dx = e.changedTouches[0].clientX - touchStartX;
  if (Math.abs(dx) > 50) show(dx < 0 ? idx + 1 : idx - 1);
});

// Delegate: any [data-lightbox-src] click collects all items in the nearest gallery container
document.addEventListener('click', e => {
  const trigger = (e.target as HTMLElement).closest('[data-lightbox-src]') as HTMLElement | null;
  if (!trigger) return;
  e.preventDefault();
  const container = trigger.closest('.gallery-masonry, .gallery-grid, .image-grid, .gallery-page-grid')
    ?? trigger.parentElement!;
  let items = Array.from(container.querySelectorAll('[data-lightbox-src]')) as HTMLElement[];
  // Restore visual order when data-lightbox-index is present (masonry columns)
  if (items[0]?.dataset.lightboxIndex !== undefined) {
    items = items.sort((a, b) =>
      parseInt(a.dataset.lightboxIndex!) - parseInt(b.dataset.lightboxIndex!)
    );
  }
  open(items, trigger.dataset.lightboxSrc!);
});
</script>
